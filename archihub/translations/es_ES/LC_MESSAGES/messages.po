# Spanish translations for the FastAPI backend.
#
# This catalogue holds ONLY msgids introduced by the rewrite. The legacy
# catalogue under app/translations/ is the primary source and is deliberately
# left untouched: app/ is the reference implementation the diff harness compares
# against, so nothing in the port writes to it. archihub/core/i18n.py registers
# this directory as a fallback, consulted only for strings the legacy catalogue
# does not define - so an existing translation always wins.
#
# At Phase 7 cutover, when app/ is deleted, the two catalogues merge into this
# one.
msgid ""
msgstr ""
"Project-Id-Version: archihub\n"
"Language: es_ES\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "DZI file not found"
msgstr "No se encontró el archivo DZI"

msgid "Filters are required"
msgstr "Los filtros son obligatorios"

msgid "Filter operator \"{op}\" is not allowed"
msgstr "El operador de filtro \"{op}\" no está permitido"

msgid "Fragment extraction is not available yet"
msgstr "La extracción de fragmentos aún no está disponible"

msgid "Image index out of range"
msgstr "Índice de imagen fuera de rango"

msgid "Invalid block index"
msgstr "Índice de bloque inválido"

msgid "Invalid dzi_payload type, expected xml or tile"
msgstr "Tipo de dzi_payload inválido, se esperaba xml o tile"

msgid "Invalid page number"
msgstr "Número de página inválido"

msgid "Invalid segment index"
msgstr "Índice de segmento inválido"

msgid "Nothing to update"
msgstr "No hay nada que actualizar"

msgid "This processing result cannot be edited"
msgstr "Este resultado de procesamiento no se puede editar"

msgid "Tile not found"
msgstr "No se encontró el mosaico"

msgid "Unknown size \"{size}\""
msgstr "Tamaño desconocido \"{size}\""

msgid "Unsupported block type"
msgstr "Tipo de bloque no soportado"

msgid "Unsupported download type"
msgstr "Tipo de descarga no soportado"

msgid "Untitled"
msgstr "Sin título"

msgid "bbox is missing"
msgstr "bbox está faltando"

msgid "id_doc is missing"
msgstr "id_doc está faltando"

msgid "level, col, and row are required for tile requests"
msgstr "level, col y row son obligatorios para las solicitudes de mosaico"

msgid "level, col, and row must be integers"
msgstr "level, col y row deben ser números enteros"

msgid "slug is missing"
msgstr "slug está faltando"

msgid "speaker and oldSpeaker are required"
msgstr "speaker y oldSpeaker son obligatorios"

msgid "{field} is missing"
msgstr "{field} está faltando"

msgid "A resource of type \"{child}\" cannot be filed under \"{parent}\""
msgstr "Un recurso de tipo \"{child}\" no puede estar bajo \"{parent}\""

msgid "The fragment could not be extracted"
msgstr "No se pudo extraer el fragmento"

msgid "The requested fragment is too long"
msgstr "El fragmento solicitado es demasiado largo"

msgid "The resource does not satisfy the new post type"
msgstr "El recurso no cumple con el nuevo tipo de contenido"

msgid "Unsupported snap type"
msgstr "Tipo de snap no soportado"

msgid "bbox is outside the image"
msgstr "bbox está fuera de la imagen"

msgid "data is missing"
msgstr "data está faltando"

msgid "Image gallery"
msgstr "Galería de imágenes"

msgid "Resource does not have files"
msgstr "El recurso no tiene archivos"

msgid "The download could not be prepared"
msgstr "No se pudo preparar la descarga"

msgid "You must specify a view"
msgstr "Debe especificar una vista"

msgid "{count} images"
msgstr "{count} imágenes"

msgid "A view with that slug already exists"
msgstr "Ya existe una vista de consulta con ese slug"

msgid "The data field is not valid JSON"
msgstr "El campo data no es un JSON válido"

msgid "The data field must be an object"
msgstr "El campo data debe ser un objeto"

msgid "The file has no content"
msgstr "El archivo no tiene contenido"

msgid "visible must be a list of content types"
msgstr "visible debe ser una lista de tipos de contenido"

# Present in the legacy catalogue but with an empty msgstr, so it was never
# translated there and msgfmt omits it from the compiled .mo - which lets this
# fallback catalogue supply it.
msgid "Only image files are allowed for views"
msgstr "Solo se permiten imágenes para las vistas de consulta"

msgid "A view can only have one file"
msgstr "Una vista de consulta solo puede tener un archivo"

msgid "\"{field}\" must be a text value"
msgstr "\"{field}\" debe ser un valor de texto"

msgid "Invalid area threshold"
msgstr "Umbral de área inválido"

msgid "Invalid bounds"
msgstr "Límites geográficos inválidos"

msgid "You must specify a level"
msgstr "Debe especificar un nivel"

# The legacy code used a Spanish string as the msgid here, which made it
# untranslatable and inconsistent with every other message in the catalogue.
# The port uses the English msgid; this supplies the Spanish.
msgid "Shape not found"
msgstr "Forma no encontrada"

msgid " … [earlier message shortened to fit]"
msgstr " … [mensaje anterior acortado para que quepa]"

msgid "A provider with that name already exists"
msgstr "Ya existe un proveedor con ese nombre"

msgid "Conversation created"
msgstr "Conversación creada"

msgid "Conversation deleted"
msgstr "Conversación eliminada"

msgid "Conversation updated"
msgstr "Conversación actualizada"

msgid "Headers must be a map of text values"
msgstr "Las cabeceras deben ser un mapa de valores de texto"

msgid "Message content must be text or a list of parts"
msgstr "El contenido del mensaje debe ser texto o una lista de partes"

msgid "Provider created successfully"
msgstr "Proveedor creado con éxito"

msgid "Provider deleted successfully"
msgstr "Proveedor eliminado con éxito"

msgid "Provider not found"
msgstr "Proveedor no encontrado"

msgid "Provider updated successfully"
msgstr "Proveedor actualizado con éxito"

msgid "The \"{header}\" header cannot be set here"
msgstr "La cabecera \"{header}\" no se puede definir aquí"

msgid "The base URL must be an http or https address"
msgstr "La URL base debe ser una dirección http o https"

msgid "The conversation is too long for this model, even after shortening"
msgstr "La conversación es demasiado larga para este modelo, incluso después de acortarla"

msgid "The model \"{model}\" does not support: {missing}"
msgstr "El modelo \"{model}\" no admite: {missing}"

msgid "This dialect requires a base URL"
msgstr "Este dialecto requiere una URL base"

msgid "Unknown conversation type \"{type}\""
msgstr "Tipo de conversación desconocido \"{type}\""

msgid "Unknown dialect \"{dialect}\""
msgstr "Dialecto desconocido \"{dialect}\""

msgid "Unknown message role \"{role}\""
msgstr "Rol de mensaje desconocido \"{role}\""

msgid "You must specify a model"
msgstr "Debe especificar un modelo"

msgid "[image]"
msgstr "[imagen]"

msgid "enabled must be true or false"
msgstr "enabled debe ser true o false"

msgid "messages must be a list"
msgstr "messages debe ser una lista"

msgid "Skill content is required"
msgstr "El contenido de la habilidad es obligatorio"

msgid "Skill deleted successfully"
msgstr "Habilidad eliminada con éxito"

msgid "Skill not found"
msgstr "Habilidad no encontrada"

msgid "Skill path is required"
msgstr "La ruta de la habilidad es obligatoria"

msgid "Skill path must be relative to the skills directory"
msgstr "La ruta de la habilidad debe ser relativa al directorio de habilidades"

msgid "Skill path must stay inside the skills directory"
msgstr "La ruta de la habilidad debe permanecer dentro del directorio de habilidades"

msgid "The skill could not be deleted"
msgstr "No se pudo eliminar la habilidad"

msgid "The skill could not be saved"
msgstr "No se pudo guardar la habilidad"

msgid "The skill is too large"
msgstr "La habilidad es demasiado grande"

msgid "\"{field}\" must be a list of text values"
msgstr "\"{field}\" debe ser una lista de valores de texto"

msgid "\"{field}\" must be a number"
msgstr "\"{field}\" debe ser un número"

msgid "Search is not enabled on this instance"
msgstr "La búsqueda no está habilitada en esta instancia"

msgid "That page is beyond the searchable range; narrow the search instead"
msgstr "Esa página está fuera del rango consultable; refine la búsqueda"

msgid "The request body must be an object"
msgstr "El cuerpo de la petición debe ser un objeto"

msgid "The search could not be completed"
msgstr "No se pudo completar la búsqueda"

msgid "You must specify a post type"
msgstr "Debe especificar un tipo de contenido"
